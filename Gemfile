source "https://rubygems.org"

# Aligns the local environment with GitHub Pages' native builder
gem "github-pages", "~> 232", group: :jekyll_plugins

# Google Drive integration for fetching spreadsheets
gem "google_drive"

# REQUIRED: Ruby 3.x removed webrick from the core library; Jekyll needs this to run locally
gem "webrick", "~> 1.8"
